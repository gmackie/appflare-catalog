{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "dataflare",
  "name": "Dataflare Analytics",
  "tagline": "Product analytics in your Cloudflare account",
  "summary": "Collect browser events, explore funnels and cohorts, and review session replays in a self-hosted dashboard. Events live in D1 and replays in R2.",
  "homepage": "https://dataflare.dev/",
  "repo": "ISNIT0/glass-analytics",
  "license": "MIT",
  "categories": ["analytics", "developer-tools"],
  "authors": [
    {
      "name": "The Dataflare Authors",
      "github": "ISNIT0",
      "url": "https://dataflare.dev/"
    }
  ],
  "maintainers": ["gmackie"],
  "source": {
    "ref": "dataflare-cli@0.8.4",
    "sha": "e9a6092a97f1502406fd2a8f1c4aa83c78b220e2",
    "version": "0.8.4"
  },
  "install": {
    "packageManager": "pnpm",
    "wranglerConfig": "packages/worker/wrangler.jsonc",
    "buildCommand": "pnpm run build",
    "health": {
      "path": "/health"
    },
    "configPatch": {
      "assets": {
        "directory": "./appflare-notices"
      }
    }
  },
  "plan": "free",
  "secrets": [
    {
      "name": "GLASS_ADMIN_KEY",
      "label": "Dataflare administrator key",
      "generate": "password"
    },
    {
      "name": "GLASS_READ_KEY",
      "label": "Read-only analytics key",
      "generate": "password"
    },
    {
      "name": "GLASS_SALT_SECRET",
      "label": "Visitor hashing secret",
      "generate": "password"
    }
  ],
  "vars": [
    {
      "name": "GLASS_PUBLIC_URL",
      "label": "Public analytics origin",
      "default": "{{appUrl}}"
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open `/app` on your new Worker and sign in with the Dataflare administrator key. Create a project in Settings and use its project ID with the [browser SDK](https://dataflare.dev/docs/sdk/). This package uses the D1 event store and requires R2 for replay. For the optional Basin lake deployment, use [Dataflare’s native installer](https://dataflare.dev/docs/getting-started/). The installed site serves the license notices at `/THIRD-PARTY-NOTICES.txt`."
    }
  ]
}
